{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Ce nom doit être celui du Worker créé dans Cloudflare (par défaut : le nom du dépôt GitHub).
  "name": "carnet-degustation",
  "main": "src/index.js",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Les requêtes /api/* passent par le Worker, tout le reste est servi directement.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "carnet-degustation",
      // À REMPLACER par l'identifiant de ta base D1 (voir README.md, étape 2).
      // En développement local, cette valeur d'exemple suffit.
      "database_id": "7fbc126f-a4d7-4559-be41-62c05586ac79"
    }
  ],
  // Photos d'étiquette (Cloudflare R2, voir README.md). Le bucket « carnet-photos » doit exister,
  // sinon Cloudflare refuse le déploiement.
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "carnet-photos" }],
  // Envoi des e-mails de récupération de mot de passe (Cloudflare Email Service, voir README.md, étape 4).
  // À décommenter une fois le domaine ajouté dans Email Service : sans cela, Cloudflare refuse le déploiement.
  // "send_email": [{ "name": "EMAIL" }],
  "vars": {
    // Adresse d'expédition, sur un domaine ajouté à Email Service (par exemple "carnet@mondomaine.fr").
    // Vide : la récupération par e-mail est désactivée.
    "MAIL_FROM": ""
  },
  "observability": { "enabled": true }
}
